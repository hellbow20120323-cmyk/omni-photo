{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && rm -rf src-tauri/dist && cp -r dist src-tauri/dist",
    "devPath": "http://localhost:1420",
    "distDir": "dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "OmniPhoto",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "all": true },
      "window": { "all": true },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "scope": ["**"]
      },
      "path": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": [], 
      "identifier": "com.cullen.omniphoto", 
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": ["dist/**/*"],
      "macOS": {
        "entitlements": "Entitlements.plist",
        "signingIdentity": "Developer ID Application: tallboy chen (8JWMAN8ZT3)"
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "OmniPhoto — Photo organizer · 照片整理",
        "width": 900,
        "height": 700
      }
    ]
  }
}
